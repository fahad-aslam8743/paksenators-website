# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is already in .gitignore — never commit real secrets.

# ---------------------------------------------------------------------
# REQUIRED — without this, the server starts but every CMS read/write
# route responds 503 "Admin authentication is not configured".
# ---------------------------------------------------------------------
# Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" downloads a JSON file. Paste its FULL
# contents here as ONE single-line JSON string (no line breaks).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...", ...}

# Must be exactly "default" unless you deliberately created a
# non-default named Firestore database.
FIRESTORE_DATABASE_ID=default

# ---------------------------------------------------------------------
# OPTIONAL — image uploads (membership applications, leadership photos,
# etc). Without these, image uploads will fail with a clear error;
# everything else still works.
# ---------------------------------------------------------------------
# Cloudinary Console → Dashboard for CLOUDINARY_CLOUD_NAME/API_KEY/SECRET.
# The cloud name is already hardcoded in src/lib/firebaseStorage.ts for
# uploads (no key needed client-side for that), but the API key/secret
# below are required for the backend to be able to DELETE old images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------
# OPTIONAL — video uploads go straight to YouTube. Without these, the
# video upload endpoints return 503; the rest of the site is unaffected.
# See ADMIN_SETUP.md / `npm run youtube:setup` for how to generate a
# refresh token.
# ---------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ---------------------------------------------------------------------
# Set automatically by most hosts (Render, etc) — you normally don't
# need to set this yourself for local development.
# ---------------------------------------------------------------------
# NODE_ENV=production
